loadModel(Modelica, {"4.0.0"});
loadFile("C:/Users/amcpo/VehicleModel/AlyssaModel.mo");
loadFile("C:/Users/amcpo/VehicleModel/animation/AlyssaAnimation.mo");
getErrorString();
setCommandLineOptions("+d=visxml");
simulate(AlyssaAnimation.Heave,stopTime=6,numberOfIntervals=300,tolerance=1e-7,outputFormat="csv",fileNamePrefix="Heave",variableFilter="time|points.*|telemetry.*|excitation.*|steering");
getErrorString();
simulate(AlyssaAnimation.Roll,stopTime=6,numberOfIntervals=300,tolerance=1e-7,outputFormat="csv",fileNamePrefix="Roll",variableFilter="time|points.*|telemetry.*|excitation.*|steering");
getErrorString();
simulate(AlyssaAnimation.Steering,stopTime=6,numberOfIntervals=300,tolerance=1e-7,outputFormat="csv",fileNamePrefix="Steering",variableFilter="time|points.*|telemetry.*|excitation.*|steering");
getErrorString();
simulate(AlyssaAnimation.Combined,stopTime=6,numberOfIntervals=300,tolerance=1e-7,outputFormat="csv",fileNamePrefix="Combined",variableFilter="time|points.*|telemetry.*|excitation.*|steering");
getErrorString();
