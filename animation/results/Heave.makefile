# Makefile generated by OpenModelica
# Platform: win64

# Simulations use -O3 by default
CC=clang
CXX=clang++
LINK=clang++ -shared -Xlinker --export-all-symbols
EXEEXT=.exe
DLLEXT=.dll
CFLAGS_BASED_ON_INIT_FILE=
# define OMC_CFLAGS_OPTIMIZATION env variable to your desired optimization level to override this
OMC_CFLAGS_OPTIMIZATION=-Os
DEBUG_FLAGS=$(OMC_CFLAGS_OPTIMIZATION)
CFLAGS=-municode $(CFLAGS_BASED_ON_INIT_FILE) $(DEBUG_FLAGS) -DOM_HAVE_PTHREADS -Wno-parentheses-equality -falign-functions -mstackrealign -msse2 -mfpmath=sse ${MODELICAUSERCFLAGS}   
CPPFLAGS= -I"C:/Program Files/OpenModelica1.25.4-64bit/include/omc/c" -I"C:/Program Files/OpenModelica1.25.4-64bit/include/omc" -I. -DOPENMODELICA_XML_FROM_FILE_AT_RUNTIME -DOMC_MODEL_PREFIX=Heave -DOMC_NUM_MIXED_SYSTEMS=0 -DOMC_NUM_LINEAR_SYSTEMS=8 -DOMC_NUM_NONLINEAR_SYSTEMS=0 -DOMC_NDELAY_EXPRESSIONS=0 -DOMC_NVAR_STRING=0
# define OMC_LDFLAGS_LINK_TYPE env variable to "static" to override this
OMC_LDFLAGS_LINK_TYPE=dynamic
RUNTIME_LIBS=-lSimulationRuntimeC -Wl,-Bdynamic -lomcgc -lryu -lopenblas -Wl,-B$(OMC_LDFLAGS_LINK_TYPE)  -lstdc++ -Wl,-Bdynamic 
LDFLAGS=-L"C:/Program Files/OpenModelica1.25.4-64bit/lib//omc" -L"C:/Program Files/OpenModelica1.25.4-64bit/lib" -Wl,--stack,16777216,-rpath,"C:/Program Files/OpenModelica1.25.4-64bit/lib//omc" -L"C:/Program Files/OpenModelica1.25.4-64bit/bin" -Wl,-rpath,"C:/Program Files/OpenModelica1.25.4-64bit/lib"  -fopenmp -Wl,-Bstatic -lregex -ltre -lintl -liconv -lexpat -lpthread -loleaut32 -limagehlp -lhdf5 -lz -lsz -Wl,-Bdynamic $(RUNTIME_LIBS) 
DIREXTRA=-L"C:/Users/amcpo/VehicleModel/animation"
MAINFILE=Heave.c
MAINOBJ=Heave.o
CFILES=Heave_functions.c Heave_records.c \
Heave_01exo.c Heave_02nls.c Heave_03lsy.c Heave_04set.c Heave_05evt.c Heave_06inz.c Heave_07dly.c \
Heave_08bnd.c Heave_09alg.c Heave_10asr.c Heave_11mix.c Heave_12jac.c Heave_13opt.c Heave_14lnz.c \
Heave_15syn.c Heave_16dae.c Heave_17inl.c Heave_18spd.c \
   Heave_08bnd_part0.c\
   Heave_08bnd_part1.c\
   Heave_08bnd_part2.c\
   Heave_08bnd_part3.c\
   Heave_08bnd_part4.c\
   Heave_08bnd_part5.c\
   Heave_08bnd_part6.c\
   Heave_08bnd_part7.c\
   Heave_08bnd_part8.c\
   Heave_08bnd_part9.c\
   Heave_08bnd_part10.c\
   Heave_06inz_part0.c\
   Heave_06inz_part1.c\
   Heave_06inz_part2.c\
   Heave_06inz_part3.c\
   Heave_06inz_part4.c\
   Heave_06inz_part5.c\
   Heave_06inz_part6.c\
   Heave_06inz_part7.c\
   Heave_06inz_part8.c\
   Heave_06inz_part9.c\
   Heave_06inz_part10.c

OFILES=$(CFILES:.c=.o)
GENERATEDFILES=$(MAINFILE) Heave.makefile Heave_literals.h Heave_functions.h $(CFILES)

.PHONY: omc_main_target clean bundle

# This is to make sure that Heave_*.c are always compiled.
.PHONY: $(CFILES)

omc_main_target: $(MAINOBJ) Heave_functions.h Heave_literals.h $(OFILES)
	$(CC) -I. -o Heave$(EXEEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

omc_dll_target: $(MAINOBJ) Heave_functions.h Heave_literals.h $(OFILES)
	$(CC) -DOMC_DLL_MAIN_DEFINE -o $(MAINOBJ) -c $(MAINFILE) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)
	$(CC) -shared -I. -o Heave$(DLLEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

clean:
	@rm -f Heave_records.o $(MAINOBJ)

bundle:
	@tar -cvf Heave_Files.tar $(GENERATEDFILES)